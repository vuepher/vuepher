package [[ .Package ]]

import (
	"github.com/vuepher/vuepher"
	"github.com/vuepher/vuepher/orm"
)

// [[ .Name ]] is the model for the `[[ .Table ]]` table.
//
// Generated by `vuepher make:model [[ .Name ]]`.
//
// Each exported field becomes a column: the name is derived the same way the
// migration derives it (Snake case), and the `json` tag is the prop name the Vue
// component receives, so the frontend and the database agree on field names.
type [[ .Name ]] struct {
	vuepher.Model

	// TODO: add your columns. The validate tag is enforced by ctx.Validate.
	//
	// Title string `json:"title" validate:"required,min=3,max=120"`
	// Body  string `json:"body"`
}

// TableName declares the table explicitly.
//
// Without it GORM would pluralise the struct name, which is the same answer —
// but declaring it means a rename of the struct cannot silently retarget the
// model at a different table.
func ([[ .Name ]]) TableName() string { return "[[ .Table ]]" }

// Query starts a fluent query against the [[ .Table ]] table:
//
//	items, err := [[ .QueryType ]]().Where("published = ?", true).Latest().Paginate(ctx, 15)
//
// The method exists so call sites read like Eloquent while the implementation
// uses Go generics, which keeps the result type concrete. Go does not allow a
// generic function and a generic type to share a name, so the constructor is
// orm.Query[T]() and the builder it returns is orm.Builder[T].
func (m [[ .Name ]]) Query() *[[ .QueryResultType ]] {
	return [[ .QueryType ]]()
}
