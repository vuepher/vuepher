package [[ .Package ]]

// [[ .Name ]] describes and validates incoming request data.
//
// Generated by `vuepher make:request [[ .Name ]]`.
//
// Tags do double duty:
//
//	json:"title"                 the key read from the request payload
//	validate:"required,min=3"    the rule enforced by ctx.Validate
//
// Because Bind accepts both JSON and form payloads, the same struct serves a
// fetch() call and a plain HTML form.
//
// Handled in the controller:
//
//	var req [[ .Name ]]
//	if err := ctx.Validate(&req); err != nil {
//		return ctx.BackWithErrors(err)
//	}
//
// Errors are flashed to the session, so the next page receives them as the
// `errors` prop and useVuepherForm() displays them next to the matching field.
type [[ .Name ]] struct {
	// TODO: declare the fields this request accepts.
	//
	// Title string `json:"title" validate:"required,min=3,max=120"`
	// Body  string `json:"body"  validate:"required"`
}
