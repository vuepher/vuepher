package [[ .Package ]]

import (
	"github.com/vuepher/vuepher"
)

// [[ .Name ]] is middleware.
//
// Generated by `vuepher make:middleware [[ .Name ]]`.
//
// Register it globally, on a group, or on a single route:
//
//	app.Use(middleware.[[ .Name ]]())
//	router.Group(func(r vuepher.Router) {
//		r.Use(middleware.[[ .Name ]]())
//		r.Get("/dashboard", c.Index)
//	})
func [[ .Name ]]() vuepher.MiddlewareFunc {
	return func(ctx *vuepher.Context, next vuepher.HandlerFunc) error {
		// TODO: act before the handler runs.

		// Call next exactly once. Returning its error unchanged lets the
		// framework render whatever the handler produced, including a redirect.
		err := next(ctx)

		// TODO: act after the handler runs, for example logging or adding a
		// response header.
		//
		// Note that a header added here is too late if the handler already
		// wrote a response body; set headers before calling next instead.

		return err
	}
}
