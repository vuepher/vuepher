package [[ .Package ]]

import (
	"fmt"

	"[[ .FrameworkModule ]]/orm"

	"[[ .Module ]]/app/models"
)

// New[[ .Name ]] builds a factory for [[ .Model ]] records.
//
// Generated by `vuepher make:factory [[ .Name ]]`.
//
// The index passed to the build function is zero-based and unique, so generated
// values do not collide when a batch is inserted:
//
//	records, err := factories.New[[ .Name ]](50).Create(db)
func New[[ .Name ]](count int) *orm.Factory[models.[[ .Model ]]] {
	return orm.NewFactory(count, func(i int) models.[[ .Model ]] {
		return models.[[ .Model ]]{
			// TODO: fill in every required field.
			//
			// Title: [[ .Model ]]Title(i),
		}
	})
}

// [[ .Model ]]Title is a helper kept next to the factory so a seeder and a test
// produce the same style of value.
func [[ .Model ]]Title(index int) string {
	return fmt.Sprintf("[[ .Title ]] %d", index+1)
}
