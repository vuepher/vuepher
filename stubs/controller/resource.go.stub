package [[ .Package ]]

import (
	"errors"

	"[[ .FrameworkModule ]]"
	"[[ .FrameworkModule ]]/orm"

	"[[ .Module ]]/app/models"
)

// [[ .Name ]] is a resource controller for [[ .Resource ]].
//
// Generated by `vuepher make:controller [[ .Name ]] --resource`.
//
// Register it with:
//
//	router.Resource("[[ .Table ]]", &controllers.[[ .Name ]]{})
//
// The router attaches only the actions this type implements, so deleting a
// method removes its route rather than leaving one that returns 405.
//
// Queries go through the model's Query method, which keeps the result type
// concrete: models.[[ .Model ]]{}.Query() returns a builder already bound to the
// [[ .Table ]] table.
type [[ .Name ]] struct {
}

// New[[ .Name ]] builds the controller.
func New[[ .Name ]]() *[[ .Name ]] {
	return &[[ .Name ]]{}
}

// Index lists every [[ .Resource ]] and renders the index page.
func (c *[[ .Name ]]) Index(ctx *vuepher.Context) error {
	items, err := models.[[ .Model ]]{}.Query().Latest().Paginate(ctx, 15)
	if err != nil {
		return err
	}
	return ctx.View("[[ .Plural ]]/Index", vuepher.Props{"items": items})
}

// Create renders the form for a new record.
func (c *[[ .Name ]]) Create(ctx *vuepher.Context) error {
	return ctx.View("[[ .Plural ]]/Create", vuepher.Props{})
}

// Store validates the submitted payload and inserts a record, then redirects.
func (c *[[ .Name ]]) Store(ctx *vuepher.Context) error {
	// TODO: replace with a request struct in app/requests so the rules live
	// with the input shape rather than the handler:
	//
	//	vuepher make:request Store[[ .Model ]]
	var req struct {
		// Title string `json:"title" validate:"required,min=3,max=120"`
	}
	if err := ctx.Validate(&req); err != nil {
		// Errors are flashed to the session and appear as the `errors` prop of
		// the next page, which useVuepherForm() binds to automatically.
		return ctx.BackWithErrors(err)
	}

	// TODO: build and persist the record. The model helper returns the builder
	// bound to the [[ .Table ]] table:
	//
	//	item := &models.[[ .Model ]]{}
	//	query := models.[[ .Model ]]{}.Query()
	//	if err := query.Create(item); err != nil {
	//		return err
	//	}

	return ctx.RedirectRoute("[[ .Resource ]].index").With("success", "Created successfully.")
}

// Show renders a single record.
func (c *[[ .Name ]]) Show(ctx *vuepher.Context) error {
	item, err := models.[[ .Model ]]{}.Query().Find(ctx.Param("id"))
	if errors.Is(err, orm.ErrNotFound) {
		return vuepher.NotFound("The requested record does not exist.")
	}
	if err != nil {
		return err
	}
	return ctx.View("[[ .Plural ]]/Show", vuepher.Props{"item": item})
}

// Edit renders the form for an existing record.
func (c *[[ .Name ]]) Edit(ctx *vuepher.Context) error {
	item, err := models.[[ .Model ]]{}.Query().Find(ctx.Param("id"))
	if errors.Is(err, orm.ErrNotFound) {
		return vuepher.NotFound("The requested record does not exist.")
	}
	if err != nil {
		return err
	}
	return ctx.View("[[ .Plural ]]/Edit", vuepher.Props{"item": item})
}

// Update validates the payload and saves the changes.
func (c *[[ .Name ]]) Update(ctx *vuepher.Context) error {
	var req struct {
		// Title string `json:"title" validate:"required,min=3,max=120"`
	}
	if err := ctx.Validate(&req); err != nil {
		return ctx.BackWithErrors(err)
	}

	// TODO: load, mutate and save the record:
	//
	//	item, err := models.[[ .Model ]]{}.Query().Find(ctx.Param("id"))
	//	if err != nil {
	//		return err
	//	}
	//	item.Title = req.Title
	//	query := models.[[ .Model ]]{}.Query()
	//	if err := query.Save(item); err != nil {
	//		return err
	//	}

	return ctx.RedirectRoute("[[ .Resource ]].index").With("success", "Updated successfully.")
}

// Destroy deletes a record. A model embedding vuepher.Model is soft-deleted, so
// the row disappears from queries but stays recoverable.
func (c *[[ .Name ]]) Destroy(ctx *vuepher.Context) error {
	query := models.[[ .Model ]]{}.Query()
	if err := query.Where("id = ?", ctx.Param("id")).Delete(); err != nil {
		return err
	}
	return ctx.RedirectRoute("[[ .Resource ]].index").With("success", "Deleted successfully.")
}
