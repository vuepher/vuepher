// [[ .Name ]] is a resource controller for [[ .Resource ]].
//
// Generated by `vuepher make:controller [[ .Name ]] --resource`.
//
// Register it with:
//
//	router.Resource("[[ .Table ]]", &controllers.[[ .Name ]]{})
//
// Each method maps to a route:
//
//	Index    GET     /[[ .Table ]]
//	Create   GET     /[[ .Table ]]/create
//	Store    POST    /[[ .Table ]]
//	Show     GET     /[[ .Table ]]/{id}
//	Edit     GET     /[[ .Table ]]/{id}/edit
//	Update   PUT     /[[ .Table ]]/{id}
//	Destroy  DELETE  /[[ .Table ]]/{id}
//
// The bodies return the page without data, because there is no [[ .Model ]] model
// yet and Go will not compile a reference to a type that does not exist — unlike
// a dynamically typed runtime, where this file would fail on the first request
// instead. Create the model and the queries become one line each:
//
//	vuepher make:model [[ .Model ]] -m
//
// then fill in the TODO blocks, which show the call to make in the shape the
// generated model provides.
type [[ .Name ]] struct {
}

// New[[ .Name ]] builds the controller.
func New[[ .Name ]]() *[[ .Name ]] {
	return &[[ .Name ]]{}
}

