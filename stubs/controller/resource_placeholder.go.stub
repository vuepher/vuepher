// Store validates the submitted payload and inserts a record.
func (c *[[ .Name ]]) Store(ctx *vuepher.Context) error {
	// Rules live with the input shape rather than in the handler. Move this
	// struct to app/requests once it has more than a couple of fields:
	//
	//	vuepher make:request Store[[ .Model ]]
	var req struct {
		// Title string `json:"title" validate:"required,min=3,max=120"`
	}
	if err := ctx.Validate(&req); err != nil {
		// Errors are flashed to the session and arrive on the next page as the
		// `errors` prop, which useVuepherForm() binds to automatically.
		return ctx.BackWithErrors(err)
	}

	// TODO: build and persist the record.
	//
	//	item := &models.[[ .Model ]]{}
	//	query := models.[[ .Model ]]{}.Query()
	//	if err := query.Create(item); err != nil {
	//		return err
	//	}

	return ctx.RedirectRoute("[[ .Resource ]].index").With("success", "Created successfully.")
}

