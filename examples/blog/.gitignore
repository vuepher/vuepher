# --- Go ---
/vuepher-app
/vp
*.exe
*.test
*.out
/vendor/

# --- Node / Vite ---
/node_modules
.vite/
*.tsbuildinfo

# The build output is generated. The directory itself is kept so that
# `//go:embed all:public/build` in main.go always has something to match, even on
# a fresh clone before the first build.
/public/build/*
!/public/build/.gitkeep

# Runtime data: the sqlite file, logs, uploads.
/storage/*
!/storage/.gitkeep

# --- Vuepher generated code ---
/resources/js/types/generated/*
!/resources/js/types/generated/.gitkeep

# --- Secrets and local overrides ---
.env
.env.local
.env.*.local

# --- Cross-compiled binaries ---
/build/
/dist/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
