# Copy this file to .env and adjust. `.env` is git-ignored; this template is not.

APP_NAME="Blog"
# local | staging | production. Production turns on secure cookies and hides
# error detail from responses.
APP_ENV=local
APP_DEBUG=true
# Generated by `vuepher new`. Rotating it invalidates every existing session,
# which is the intended way to sign everyone out.
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_TIMEZONE=UTC

# sqlite | postgres | mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
# silent | error | warn | info
DB_LOG_LEVEL=warn

# cookie | memory  (database and redis drivers arrive in Phase 2)
SESSION_DRIVER=cookie
SESSION_NAME=vuepher_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# The Vite dev server. Ignored in production, where assets are embedded.
VITE_DEV_SERVER=http://localhost:5173
VITE_PORT=5173
